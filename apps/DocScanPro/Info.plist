<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 相机用途说明：用于文档扫描。隐私版强调本地处理。 -->
	<key>NSCameraUsageDescription</key>
	<string>DocScanPro 需要使用相机来扫描文档。所有图像与文字识别均在本机完成，不会上传任何内容。</string>

	<!-- 照片库（可选保存导出文件时使用） -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>用于将导出的 PDF 或图像保存到你的相册。</string>

	<key>CFBundleDisplayName</key>
	<string>DocScanPro</string>

	<!-- App Store 分类：效率工具 -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>

	<key>CFBundleShortVersionString</key>
	<string>1.0</string>

	<key>CFBundleVersion</key>
	<string>1</string>

	<!-- 无任何加密 / 网络传输，声明豁免出口合规，避免每次上传 TestFlight 被询问 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- SwiftUI 启动屏：无此键应用会以兼容模式（黑边）运行，无法占满屏幕 -->
	<key>UILaunchScreen</key>
	<dict/>

	<!-- 本地化：支持中文与英文 -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>zh-Hans</string>
		<string>en</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh-Hans</string>

	<!-- 仅竖屏（文档扫描场景），iPad 允许全部方向 -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- 应用支持文件分享（导出 PDF） -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!-- 明确声明不使用任何需要 ATS 例外的网络请求（无网络） -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
</dict>
</plist>
