// MARK: - Privacy policy (in-app)
"privacy.title" = "Privacy Policy";
"privacy.updated" = "Last updated: June 2026";
"privacy.intro" = "IronLog is private by design. It runs entirely on your device — no account, no servers, no analytics tracking.";
"privacy.section.collect.title" = "Data We Collect";
"privacy.section.collect.body" = "None. The workouts, exercises, personal records, and settings you enter are stored only on your device (via Apple's SwiftData). This data is never sent to the developer or any third party. Deleting the app removes all local data.";
"privacy.section.health.title" = "Health Data";
"privacy.section.health.body" = "If you turn on Health sync, IronLog writes finished workouts to Apple Health and may read your body weight to show relative strength. Health data is handled locally by the system, is never uploaded, and can be revoked anytime in Settings or the system Health permissions.";
"privacy.section.purchase.title" = "Purchases";
"privacy.section.purchase.body" = "The Pro unlock is an in-app purchase through the Apple App Store. Transactions and receipts are handled by Apple under Apple's privacy policy; IronLog only verifies your entitlement locally and never receives your payment details.";
"privacy.section.notify.title" = "Notifications";
"privacy.section.notify.body" = "Rest-timer reminders and new-record celebrations are local notifications generated on your device. No remote push service is involved.";
"privacy.section.contact.title" = "Contact";
"privacy.section.contact.body" = "Questions about privacy? Reach us via Settings → Contact Us.";
