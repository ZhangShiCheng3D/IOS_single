/* Privacy policy (available in-app) */
"privacy.intro" = "RetroFilm takes your privacy seriously. The app is fully standalone — it has no network connection, no servers, and collects no personal data. The sections below explain how each permission is used.";
"privacy.section.data.title"     = "Data We Collect";
"privacy.section.data.body"      = "None. RetroFilm does not collect, upload, or share any personal information or usage data, and contains no third-party analytics or advertising SDKs. All image processing happens locally on your device.";
"privacy.section.camera.title"   = "Camera";
"privacy.section.camera.body"    = "Camera access is used only for the live viewfinder and to capture photos. Frames are processed entirely on-device and are never sent anywhere.";
"privacy.section.photos.title"   = "Photos";
"privacy.section.photos.body"    = "The app writes a photo to your system library only when you explicitly choose “Save to Photos.” We do not read or browse your existing photos.";
"privacy.section.purchase.title" = "Purchases";
"privacy.section.purchase.body"  = "In-app purchases are handled by Apple’s StoreKit, and receipts are verified by Apple. We never see your payment information.";
"privacy.section.contact.title"  = "Contact";
"privacy.section.contact.body"   = "If you have any questions about this privacy policy, you can reach us through the developer support page for this app on the App Store.";
